# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See docs/development.md for how to obtain each value.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — create a project at https://supabase.com/dashboard, then copy
# these from Project Settings > API. Apply supabase/migrations/*.sql via
# `supabase db push` (or paste them into the SQL editor, in order) before
# running the app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Apple Wallet (PassKit) — see docs/apple-wallet-setup.md.
# Without these, AppleWalletProvider falls back to MockWalletProvider and the
# UI clearly labels passes as "modo de prueba".
# ---------------------------------------------------------------------------
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=
# PEM-encoded Pass Type ID certificate (base64 of the .pem, single line).
APPLE_CERTIFICATE_BASE64=
# PEM-encoded private key for the certificate above (base64 of the .pem).
APPLE_PRIVATE_KEY_BASE64=
# Optional passphrase if the private key is encrypted.
APPLE_PRIVATE_KEY_PASSPHRASE=
# Apple Worldwide Developer Relations intermediate certificate (PEM, base64).
APPLE_WWDR_CERTIFICATE_BASE64=
# Public URL of this app's Apple PassKit web service (no trailing slash),
# e.g. https://app.walletstore.mx/api/wallet/apple
APPLE_WEB_SERVICE_URL=

# ---------------------------------------------------------------------------
# Google Wallet — see docs/google-wallet-setup.md.
# Without these, GoogleWalletProvider falls back to MockWalletProvider.
# ---------------------------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=
# Full JSON key of a Google Cloud service account with Wallet Objects API
# access, minified to a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Stripe — see docs/billing.md. Without these, BillingProvider falls back to
# a mock adapter and billing screens show "modo de prueba".
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Resend (transactional + campaign email) — https://resend.com/api-keys
# Without this, EmailProvider falls back to ConsoleEmailProvider (logs only).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=WalletStore <notificaciones@walletstore.mx>

# ---------------------------------------------------------------------------
# Outbound webhooks (n8n-compatible automations)
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
